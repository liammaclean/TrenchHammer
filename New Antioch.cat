        <constraint id="604f-daf1-9e04-80b7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="15"/>
        <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="6aa4-b38b-5146-4106" field="selections" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Berserker" id="f634-bf69-b747-a78c" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model gains NEGATE FEAR and disregards any BLOOD MARKERS from any source. Berserkers never wear armour, though they can carry a Shield.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Chewa" id="f5cc-8e5a-445d-bc09" hidden="true" import="true" type="upgrade">
      <constraints>
        <constraint id="462d-b249-7299-6b09" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="5"/>
        <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="false">
          <conditions>
            <condition childId="9b8f-4361-5f23-2e20" field="selections" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <profiles>
        <profile name="Warrior-Elite" id="2627-14e3-3667-de20" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add +1 DICE to the Success Roll for a Melee Attack made by a model with the Chewa ability for each other friendly model within 1&quot; of the target, up to a maximum of +2 DICE.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Homunculus" id="2d0c-00e9-7897-83d7" hidden="false" import="true" type="model">
      <categoryLinks>
        <categoryLink name="Troop" id="0ce3-e1b0-e53e-d8c7" hidden="false" primary="false" targetId="bd43-ddb1-262d-4489"/>
      </categoryLinks>
