        <profile name="Convent Conditioning" id="6f5f-6393-4e08-500d" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Medic is immune to FEAR.</characteristic>
          </characteristics>
        </profile>
        <profile name="Finish the Fallen" id="195c-d9a0-91c2-1b40" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Due their knowledge of anatomy and physiology, medics are experts at inflicting debilitating injuries and excruciating pain. Unless the target has the Keyword DEMONIC or BLACK GRAIL, add +1 BONUS DICE to any injury rolls the medic makes in melee against opponents who are Down.</characteristic>
          </characteristics>
        </profile>
        <profile name="Expert Medic" id="a725-489e-1a8d-8cc1" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add +2 DICE to the Risky Success Roll when a Combat Medic carries out a Treat ACTION with their Medi-kit.</characteristic>
          </characteristics>
        </profile>
      </profiles>
