              <profiles>
                <profile name="Gargantuan Size" id="1e4b-61de-3566-2084" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Can only be bought if the Homunculus already has the Human Hands, Inhuman Strength and Massive Size Formulas. The Homunculus now has a Base Size of 60mm and it can now use one Brazen Bull Only weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Regenerative" id="3fec-dfce-031d-0147" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6c02-5d6c-73a2-d0f4" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
