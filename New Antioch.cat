              <profiles>
                <profile name="Gunslinger" id="6096-b9bf-a81f-b08e" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
                  <characteristics>
                    <characteristic name="Type" typeId="3f15-74a1-4d35-3642"/>
                    <characteristic name="Range" typeId="2b32-2f45-9c06-7a77"/>
                    <characteristic name="Keywords" typeId="5093-5528-b08f-1496"/>
                    <characteristic name="Rules" typeId="4834-43a9-1c93-9062">If armed with two pistols, this model can make ranged attack ACTIONS with both of them when making a ranged attack. In addition, this model suffers no penalty when using a pistol as an Off-Hand weapon.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
