        <constraint id="b845-3e0e-899d-4114" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="2"/>
      </constraints>
      <modifiers>
        <modifier field="b845-3e0e-899d-4114" type="set" value="1">
          <conditions>
            <condition childId="6aa4-b38b-5146-4106" field="selections" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
