    <selectionEntry name="Fireteam" id="441f-8640-cfed-8e78" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New Antioch" id="93f4-17cd-6bf6-5499" primary="false" targetId="2cfb-73f8-0df3-30e8"/>
        <categoryLink name="Fireteam" id="6ea6-acce-4425-dc0f" primary="true" targetId="83c8-b351-cb96-119e"/>
      </categoryLinks>
