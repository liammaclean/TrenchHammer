                  </costs>
                  <profiles>
                    <profile name="Hypnotic Eyes" id="1f24-9418-3e62-fe3e" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Enemies suffer -1 DICE to hit the Homunculus in Melee. Does not affect Sniper Priests or enemies with the keyword BLACK GRAIL. Cannot be combined with Hawk Eyes without Two Heads.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Hawk Eyes" id="5e49-cff8-3d14-cff5" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="6a17-2f3f-c6fc-1c7a" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
