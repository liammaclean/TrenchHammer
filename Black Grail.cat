      <profiles>
        <profile name="Special Rule: Morale" id="6138-06ef-9465-b870" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
          <characteristics>
            <characteristic name="Type" typeId="3f15-74a1-4d35-3642"/>
