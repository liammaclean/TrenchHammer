              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">At the end of a battle, if this Plague Knight is not Out of Action and it has taken at least one enemy model Out of Action with a Melee Attack, gain 1 Glory.</characteristic>
              </characteristics>
            </profile>
          </profiles>
