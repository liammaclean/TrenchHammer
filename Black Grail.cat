                  <conditionGroups>
                    <conditionGroup type="and">
                      <conditions>
                        <condition childId="f4c1-28c9-773f-c192" field="selections" includeChildSelections="true" scope="parent" shared="true" type="atLeast" value="1"/>
                        <condition childId="ee80-c780-9aa9-1e4d" field="selections" includeChildSelections="true" scope="parent" shared="true" type="atLeast" value="1"/>
