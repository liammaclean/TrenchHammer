            <characteristic name="Keywords" typeId="5093-5528-b08f-1496"/>
            <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Enemy Warbands roll Morale Tests with -1 DICE when fighting a Black Grail Warband. The Court Warbands and other Black Grail Warbands ignore this penalty.</characteristic>
          </characteristics>
        </profile>
      </profiles>
