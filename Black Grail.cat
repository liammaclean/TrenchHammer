                  <conditions>
                    <condition childId="4e66-70be-9744-7ce6" field="selections" includeChildSelections="true" scope="self" shared="true" type="atLeast" value="1"/>
                    <condition childId="83de-02a7-ba19-3570" childName="Foetid Palanquin" field="selections" includeChildSelections="true" scope="self" shared="true" type="atLeast" value="1"/>
                  </conditions>
                </modifier>
