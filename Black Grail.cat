        </modifier>
      </modifiers>
      <profiles>
        <profile name="Matagot Hag" id="9f3b-37db-7c86-c7ff" hidden="false" typeId="b3af-94f9-2e35-d1c5" typeName="Unit">
          <characteristics>
            <characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">6&quot;/Infantry</characteristic>
            <characteristic name="Ranged" typeId="1a4f-d2cd-c405-6200">-</characteristic>
            <characteristic name="Melee" typeId="12e8-ff8c-c933-9eb5">+2</characteristic>
            <characteristic name="Armour" typeId="5de9-d70e-9021-6f71">0</characteristic>
            <characteristic name="Base" typeId="73ae-cc17-596e-0481">60mm</characteristic>
          </characteristics>
          <modifierGroups>
            <modifierGroup type="and">
              <comment>armour adjustments</comment>
              <modifiers>
                <modifier field="5de9-d70e-9021-6f71" type="decrement" value="1">
