                              <characteristics>
                                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">- Boon: This model can neither Retreat, nor can enemy models Retreat from it. Additionally, this model gains IGNORE OFFHANDE PENALITY (Cost 15 ducats).</characteristic>
                              </characteristics>
                            </profile>
