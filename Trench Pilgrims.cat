            <profile name="Gas Censer" id="ca96-4933-b496-593f" hidden="false" typeId="090c-b12e-592a-9874" typeName="Weapon">
              <characteristics>
                <characteristic name="Type" typeId="f90e-171a-4ca6-3845">2-Handed</characteristic>
                <characteristic name="Range" typeId="31a7-b5e8-41dc-5fd1">6&apos;&apos;</characteristic>
                <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">GAS, IGNORE ARMOUR, RELOAD</characteristic>
                <characteristic name="Rules" typeId="87f0-637b-734a-22eb">Cloud of Gas: When you take a Shoot ACTION with this model, instead of making a Ranged Attack, you can unleash a cloud of gas. If you do so, do not make a Success Roll. Instead, all other models within 6” of the model using the Gas Censer are hit, and an Injury Roll must be made for each one. Note that the attack hits all models, friend or foe, apart from the model making the attack, regardless of Line of Sight.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
