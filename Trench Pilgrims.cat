                </modifier>
              </modifiers>
              <profiles>
                <profile name="Fire Shield" id="61e5-6561-5d91-b9c5" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
                  <characteristics>
                    <characteristic name="Type" typeId="3f15-74a1-4d35-3642"/>
                    <characteristic name="Range" typeId="2b32-2f45-9c06-7a77"/>
                    <characteristic name="Keywords" typeId="5093-5528-b08f-1496"/>
                    <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Always takes one hand to use in both melee and in ranged combat. Grants -1 to all injury rolls against the model. This bonus stacks with any armour the model wears, unless otherwise indicated. Any attack against this model that has the Keyword FIRE will suffer -1 DICE on injury rolls and will not cause an additional BLOOD MARKER.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Trench Shield (Nordic)" id="934a-994b-9a83-6663" hidden="true" import="true" sortIndex="1" type="upgrade">
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
