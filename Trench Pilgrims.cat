                <characteristic name="Range" typeId="31a7-b5e8-41dc-5fd1">48&quot;</characteristic>
                <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">+1 INJURY DICE, BLAST 3&apos;&apos;, FIRE, HEAVY, IGNORE COVER, SCATTER</characteristic>
                <characteristic name="Rules" typeId="87f0-637b-734a-22eb">High Trajectory: When a Trench Mortar is used to make a Ranged Attack, the target model (or target point, if targeting a point on the ground) cannot be within 6&quot; of the attacking model. Note that if the attack Scatters it may end up landing within 6&quot; of the attacking model.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gas Censer" id="bf35-3729-df69-7562" hidden="true" import="true" type="upgrade">
          <constraints>
