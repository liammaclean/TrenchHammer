      <selectionEntries>
        <selectionEntry name="Blood Eagle Banner" id="3da5-afdc-ed33-d56a" hidden="true" import="true" type="upgrade">
          <comment>Option for CoY</comment>
          <constraints>
            <constraint id="6dab-b7df-284d-e2aa" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6af1-db8d-ec64-4f32" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="30"/>
            <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Held" id="80fa-48a8-e95d-effe" hidden="false" targetId="1220-c65a-89ed-96a7" type="rule"/>
          </infoLinks>
