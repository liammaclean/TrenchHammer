                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Trench Shield (Nordic)" id="fdd6-07ba-42a3-3578" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
                  <characteristics>
                    <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Shield</characteristic>
                    <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                    <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-</characteristic>
                    <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Provides the benefit of cover at all times and a model equipped with a Trench Shield (Nordic) always count as having the defended obstacle bonus when charged.

Additionally, a friendly model in base to base contact with a model equipped with a Trench Shield (Nordic) treats the shieldbearer as cover, following the normal rules for cover.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Stormbreaker Shield" id="2b6a-92de-ea42-85c4" hidden="true" import="true" type="upgrade">
              <comment>Huscarl unique option (CoY)</comment>
              <costs>
