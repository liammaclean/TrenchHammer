          </modifiers>
          <profiles>
            <profile name="Sacrificial Lamb" id="e51e-7de9-7131-6994" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Equipment</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">CONSUMABLE</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">* Warded by Blood: When you deploy a model that has a Sacrificial Lamb, you can say that they will sacrifice it and anoint themselves with its blood. If you do so, the first BLOOD MARKER placed on the model is ignored.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Henbrane" id="5714-931f-09eb-f186" hidden="true" import="true" sortIndex="4" type="upgrade">
          <comment>Option for CoY</comment>
          <constraints>
            <constraint id="e8e7-3b8c-92f7-eb3d" field="selections" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e629-b6f0-458a-f9bc" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="2"/>
