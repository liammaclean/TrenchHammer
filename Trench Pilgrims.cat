        <profile name="Runeforged Armour" id="7e36-5ca4-b01e-f349" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
          <characteristics>
            <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Armour</characteristic>
            <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
            <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-2 INJURY MODIFIER</characteristic>
            <characteristic name="Rules" typeId="4834-43a9-1c93-9062">If an attack would normally ignore armour, Runeforged Armour still grants a -1 INJURY MODIFIER.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bodyguard" id="e54a-214b-36ef-b598" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">If a friendly PILGRIM model within 1&quot; of a Huscarl is hit by a Ranged Attack or Melee Attack, you can say that the Huscarl will take the hit. If you do so, make an Injury Roll for the Huscarl instead of the original target. This ability cannot be used against attacks that have the BLAST Keyword.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
