      <profiles>
        <profile name="Bodyguard" id="b241-36e1-f345-a731" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">If a friendly PILGRIM model within 1&quot; of a Communicant is hit by a Ranged Attack or Melee Attack, you can say that the Communicant will take the hit. If you do so, make an Injury Roll for the Communicant instead of the original target. This ability cannot be used against attacks that have the BLAST Keyword.</characteristic>
          </characteristics>
        </profile>
        <profile name="Communicant" id="53e3-a873-a192-6a91" hidden="false" typeId="b3af-94f9-2e35-d1c5" typeName="Unit">
