            <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="eee9-35a4-9eda-70e9" field="selections" includeChildSelections="true" scope="roster" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Death From On High" id="7215-1443-8f01-62bf" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add 3&quot; to the height of a model that has a Tank Palanquin when determining if it receives the Elevated Position modifier for any Ranged Attacks that it makes.</characteristic>
              </characteristics>
            </profile>
            <profile name="Bulky" id="8bf3-11bd-c1a9-c4f9" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A model that has a Tank Palanquin must be mounted on a 50mm base and cannot be equipped with a Shield. In addition, it has a Charge Bonus of D3&quot; instead of D6&quot;.</characteristic>
              </characteristics>
            </profile>
            <profile name="Standfast" id="daef-b905-2d3b-abb6" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">When a model that has a Tank Palanquin suffers a Down result on the Injury table, it is treated as a Minor Wound result instead.</characteristic>
              </characteristics>
            </profile>
            <profile name="Tank Palanquin" id="835c-9624-303f-5792" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Armour</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-3 INJURY MODIFIER, STRONG</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062"/>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
