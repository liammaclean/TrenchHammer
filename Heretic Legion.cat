      <selectionEntries>
        <selectionEntry name="Tank Palanquin" id="61b5-8cd2-9946-22fd" hidden="true" import="true" sortIndex="3" type="upgrade">
          <constraints>
            <constraint id="6dbf-3911-b4ac-74af" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
