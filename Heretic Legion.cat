        <profile name="Stealth Generator" id="1110-b5e7-9966-1383" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add -1 DICE to rolls for Ranged Attacks that target a Death Commando.</characteristic>
          </characteristics>
        </profile>
        <profile name="Hide" id="1191-44c6-b786-d49d" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Death Commando can take a Hide ACTION if they are in contact with a terrain piece that is at least ½&quot; high. If they do so, take a Risky Success Roll for the model and add +1 DICE to the roll. If the roll is a Failure, the Death Commando’s Activation ends immediately. If the roll is a Success or Critical Success, enemy models cannot choose the Death Commando as the target for a Ranged Attack or Charge until the Death Commando moves, charges, retreats, makes a Ranged Attack, or an enemy model moves within 1.5&quot; of them. The Death Commando can be hit if they are within the blast radius of a Weapon with the BLAST Keyword.</characteristic>
          </characteristics>
        </profile>
