        <selectionEntry name="Sniper Scope" id="4ada-fe73-318e-83f2" hidden="true" import="true" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="80cb-218f-fa40-0a7a" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="2"/>
            <constraint id="ce17-3ecd-51e3-bd4e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="0"/>
            <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="2"/>
