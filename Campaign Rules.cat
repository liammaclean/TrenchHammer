          <constraints>
            <constraint id="e173-1c83-b90a-6b4d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Shell-shocked" id="6927-5599-ef57-d50b" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Roll a D6 the first time this model is deployed during a game. On a 1-2, add -1 DICE to rolls for this model for the rest of the game.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
