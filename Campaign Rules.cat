        <selectionEntry name="Lordship of this World" id="9ab3-2522-a7dd-e902" hidden="true" import="true" type="upgrade">
          <constraints>
            <constraint id="478d-0872-1bd0-faa5" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="2b8f-ffbd-b2a6-4659" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
