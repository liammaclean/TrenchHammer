            <selectionEntry name="Equipment Only" id="e144-fd65-dd37-8ba2" hidden="false" import="true" sortIndex="2" type="upgrade">
              <profiles>
                <profile name="Campaign Rules: Enabled" id="6250-9440-acde-584c" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
