                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Famous Deeds: At the end of each game, your Warband receives 1 Glory Point for each model with a Knighthood that is on the battlefield.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
