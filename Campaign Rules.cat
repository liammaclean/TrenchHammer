          <profiles>
            <profile name="Lost an Eye" id="4d3c-d4ee-ec70-5b68" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The character suffers -1 DICE for all of its range attack ACTIONS. Suffering two such injuries blinds the model and it has to retire from the campaign.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Chest Wound [16]" id="31c3-974d-6998-3ca9" hidden="false" import="true" sortIndex="4" type="upgrade">
