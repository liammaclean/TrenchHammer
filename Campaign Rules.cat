            <profile name="Leg Wound" id="4448-ff1e-3fe7-f885" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The model’s Movement Characteristic is reduced by 2” and it suffers -1 DICE to Dash.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Expensive Treatment [32]" id="390f-5c4a-27e5-d2b5" hidden="false" import="true" sortIndex="12" type="upgrade">
          <comment>32</comment>
          <constraints>
            <constraint id="1e81-1f6c-8039-3fca" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Expensive Treatment" id="03a6-9fe1-b6a5-5d9e" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The character’s wounds require constant treatment. To deploy this model, you must deduct 10 ducats from your strongbox. This payment does not count towards your Warband’s Threshold Value</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Possessed [33]" id="9733-80cf-7b2f-a6c7" hidden="false" import="true" sortIndex="13" type="upgrade">
          <comment>33</comment>
          <constraints>
            <constraint id="8c31-b33c-aa4f-473b" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Possessed" id="c5fd-2128-3843-4f5b" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">While unconscious, the model was possessed by a restless spirit of a dead soldier. If possible, this model must begin its Activation with a Dash and this Dash must cover a distance of at least 3” in a single direction. If this model is Down at the start of its Activation, it must instead first Stand and then attempt to Dash. If this model begins its Activation in melee combat, it may ignore these restrictions during that Activation.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Minor Wound [35]" id="4845-23cb-4415-852e" hidden="false" import="true" sortIndex="15" type="upgrade">
          <comment>35</comment>
          <constraints>
            <constraint id="250d-ace7-38f7-3866" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Minor Wound" id="26c9-35d7-274b-3fd8" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">After receiving this injury, this model cannot be fielded next battle. It maintains this as a Scar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hardened [64]" id="ba58-7252-8cee-bc76" hidden="false" import="true" sortIndex="16" type="upgrade">
          <comment>64</comment>
          <constraints>
            <constraint id="e887-ab98-f729-7862" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Hardened" id="1edf-844c-2ff1-c326" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model now ignores the effects of the Keyword FEAR. No Battle Scar is suffered.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Prominent Scar [66]" id="b9a1-e5b7-03d7-2063" hidden="false" import="true" sortIndex="18" type="upgrade">
          <constraints>
            <constraint id="b1fc-ffcc-5477-d6e6" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Prominent Scar" id="039f-ea9e-d91a-8c8c" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Write down the name of the Warband from the game where this injury was received. Add +1 DICE to rolls for Melee Attacks made by this model if the target is a model from the Warband you have written down. It does not receive an Injury or a Battle Scar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Target of Ire" id="a302-6b31-d9d6-4098" hidden="false">
              <constraints>
                <constraint id="ed20-5d3f-9942-2b74-min" field="selections" includeChildSelections="false" scope="self" shared="true" type="min" value="1"/>
                <constraint id="ed20-5d3f-9942-2b74-max" field="selections" includeChildSelections="false" scope="self" shared="true" type="max" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="Scarred by the Grail" id="47a8-1ec3-906d-c4b0" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Scarred by the Grail" id="5524-ece8-862b-08af" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model gains +1 DICE for all melee attack ACTIONS against all enemies with the Faction Keyword &quot;Black Grail&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Scarred by the Court" id="dbae-1a8a-f072-4a17" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Scarred by the Court" id="8a2f-c5c7-0d6c-7a58" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model gains +1 DICE for all melee attack ACTIONS against all enemies with the Faction Keyword &quot;The Court&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Scarred by the Heretics" id="7754-da24-d5aa-37ca" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Scarred by the Heretics" id="fcca-5efb-2f2f-b181" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model gains +1 DICE for all melee attack ACTIONS against all enemies with the Faction Keyword &quot;Heretic&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Scarred by the Sultanate" id="48fb-c178-f2c6-fd03" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Scarred by the Sultanate" id="d077-722d-5f8d-9817" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model gains +1 DICE for all melee attack ACTIONS against all enemies with the Faction Keyword &quot;Sultanate&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Scarred by the Antiochians" id="dc5a-970a-3d95-cab6" hidden="false" import="true" type="upgrade">
                  <profiles>
                    <profile name="Scarred by the Antiochians" id="a374-26cc-69d2-f083" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                      <characteristics>
                        <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model gains +1 DICE for all melee attack ACTIONS against all enemies with the Faction Keyword &quot;New Antioch&quot;</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Scarred by the Pilgrims" id="9cfc-db10-0f04-7d47" hidden="false" import="true" type="upgrade">
