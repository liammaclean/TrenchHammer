                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Increase the Limit of one non-ELITE unit available to your warband by 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
