          <profiles>
            <profile name="Resurrection Engine" id="f10c-88b8-0b18-3833" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Special</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">CONSUMABLE</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Holy Machine: A Resurrection Engine is not allocated to a model (just add it to your Arsenal instead). Once during the campaign, you can use the Resurrection Engine to change the result rolled on the Trauma Table to a Full Recovery result. The Resurrection Engine is Consumed when it is used.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sultanate Grand Cannon" id="d9f1-b37e-ff7c-cffe" hidden="true" import="true" type="upgrade">
          <comment>Bull Weapon</comment>
          <categoryLinks>
            <categoryLink name="Bull" id="88f8-f16f-5457-769f" primary="false" targetId="0934-cc68-ca08-7e2b"/>
          </categoryLinks>
