            <selectionEntry name="Stable logistics" id="3d05-4a22-6d65-fd5c" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="ed92-01d3-3a30-bbad" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Stable logistics" id="b570-e800-4b84-7748" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Through shrewd trade this model has made connections with the advanced caravan network of the wastelands, in the Exploration stage of the post battle sequence, you may add 1 piece of equipment, weapon or armor from your faction equipment list without cost. This item must have a value of 15 ducats or less.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Ghazwa" id="ed50-6d80-6474-b174" hidden="false" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="0eac-1082-705f-d0cb" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Ghazwa" id="83c2-67cd-0721-0a46" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">When rolling for ducats in the Exploration stage of the Post Battle Sequence, add 10 ducats to the total result for every enemy model that was taken Out of Action during the game.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Mubaraza" id="a633-0a74-73ca-38a6" hidden="false" import="true" sortIndex="4" type="upgrade">
              <constraints>
                <constraint id="0102-fd22-ff35-c8b3" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
