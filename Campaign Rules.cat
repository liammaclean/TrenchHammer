          </modifiers>
          <profiles>
            <profile name="Armour of the Fly" id="6f72-4947-54b8-efc7" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Armour</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-2 INJURY MODIFIER, NEGATE SHRAPNEL</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Insect Wings: Change the Movement Characteristic of a model that has the Armour of the Fly to 8&quot;/Flying.

Sucked Dry: After a model that has the Armour of the Fly makes a Melee Attack, it can immediately make a second Melee Attack with +1 DICE to the roll for the second attack. However, do not make an Injury Roll if the second attack hits the target; instead place 1 BLOOD MARKER next to the target model.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ducal Winged Armour" id="03eb-5358-03ae-8046" hidden="true" import="true" type="upgrade">
          <comment>Knights only!</comment>
          <constraints>
            <constraint id="c163-a17e-ca84-ddfd" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="d3bd-67d8-f569-599f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
