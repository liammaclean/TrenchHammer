          </modifiers>
          <profiles>
            <profile name="Great Banner of New Antioch" id="cc1a-f917-862d-26dc" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Equipment</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">Held</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Rally to the Flag: If a model with a Great Banner of New Antioch is on the Battlefield when you take a Morale Check (even if they are Down), you can choose for the Morale Check to be a Success or for your Warband to flee.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Resurrection Engine" id="28c1-351c-12d0-1f26" hidden="true" import="true" type="upgrade">
          <constraints>
