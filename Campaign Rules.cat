    <selectionEntryGroup name="Melee &amp; Strength Skills" id="f04b-40da-ca56-b233" hidden="false">
      <selectionEntries>
        <selectionEntry name="Stand Firm [3]" id="03ac-c426-6f9e-5616" hidden="false" import="true" sortIndex="1" type="upgrade">
          <constraints>
            <constraint id="b2d4-d06a-28d1-b703" field="selections" includeChildSelections="false" scope="e01c-f1e9-f8ca-e6c9" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Stand Firm" id="1214-88e2-acdb-e74a" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The first time a model with this Skill suffers a Down result on the Injury table, it is treated as a Minor Wound result instead.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Parry [4]" id="3970-e2b3-e503-7dd0" hidden="false" import="true" sortIndex="2" type="upgrade">
