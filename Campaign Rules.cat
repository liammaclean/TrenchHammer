          <profiles>
            <profile name="Damascus Armour" id="8b57-bf47-6a34-7732" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Armour</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-2 INJURY MODIFIER, IMPERVIOUS</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Inspiring Gift: A model that has a suit of Damascus Armour is not sent back home until they suffer their 4th Battle Scar. In addition, a suit of Damascus Armour cannot be removed from a model during a campaign unless the model wearing it has been killed or been declared Unfit for Duty.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Great Banner of New Antioch" id="53fc-b3e3-e7f6-6ce5" hidden="true" import="true" type="upgrade">
          <constraints>
            <constraint id="29d4-8fcd-34d0-b7b7" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="0149-bf69-ea42-249a" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
