                <constraint id="0f65-993b-aabe-145a" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Walk With God" id="4104-3f94-f835-6c0d" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Pick one Skill from any Skill Chart available to the model, including any Exploration Skill, and give it to this model.
(Note: just pick the skill you would get from this, instead. It is included here only for posterity.)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Knowledge of the Sciences" id="baf9-97f6-2393-eeca" hidden="false" import="true" sortIndex="2" type="upgrade">
