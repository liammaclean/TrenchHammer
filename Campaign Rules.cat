              </constraints>
              <profiles>
                <profile name="Mendelist Chemicals" id="4efa-4ea0-1d4a-64e3" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The opposing player cannot spend BLOOD MARKERS next to a model with this skill to add +1 INJURY DICE (they can use the BLOOD MARKERS to convert the roll to a Bloodbath Roll normally).</characteristic>
                  </characteristics>
                </profile>
