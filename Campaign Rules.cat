                    <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Enables Skills, Injuries, and Campaign-only Equipment.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Warchest of Ducats" id="f192-897d-59d9-7a91" hidden="false" import="true" sortIndex="4" type="upgrade"/>
