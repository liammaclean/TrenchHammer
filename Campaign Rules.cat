          <profiles>
            <profile name="Battlefield Title" id="06c4-5a96-4182-9c79" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Equipment</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Privileged Access: Pick 1 Weapon or suit of Armour from your Armoury Tables that has the Limit special rule. Note on your Warband Roster that the Limit is increased by 1. The increase will remain in place even if the model that has the Battlefield Title is removed from your Roster later during the campaign. You are encouraged to come up with a special title for the Weapon or Armour that you have gained access to.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Executioner&apos;s Axe" id="b3a8-7dea-49be-d447" hidden="true" import="true" type="upgrade">
          <constraints>
