          </modifiers>
          <profiles>
            <profile name="Brazen Bull Grand Cannon" id="55cc-bfda-1fd4-0633" hidden="false" typeId="090c-b12e-592a-9874" typeName="Weapon">
              <characteristics>
                <characteristic name="Type" typeId="f90e-171a-4ca6-3845">1-handed</characteristic>
                <characteristic name="Range" typeId="31a7-b5e8-41dc-5fd1">48&quot;</characteristic>
                <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">+2 INJURY DICE, HEAVY, IGNORE ARMOUR</characteristic>
                <characteristic name="Rules" typeId="87f0-637b-734a-22eb">Unstoppable Object: If a model that has been hit by a Sultanate Grand Cannon is not taken Out of Action by the Injury Roll, it is pushed D6&quot; in a straight line directly away from the attacking model. The model stops if it pushed into another model, Impassable terrain or a terrain piece it cannot cross without having to Climb.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Beelzebub&apos;s Embrace" id="46b5-59af-5d44-2cb0" hidden="true" import="true" type="upgrade">
          <comment>Elite only!</comment>
          <constraints>
            <constraint id="d9f0-067e-92b2-2cec" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="9407-d482-f6ff-6f57" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="0"/>
            <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="12"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
