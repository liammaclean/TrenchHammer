              <profiles>
                <profile name="Mubaraza" id="9598-8f0b-1702-1512" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">all units in this warband (excluding Allies) gain +1 DICE to their melee characteristic when wielding a single melee weapon in only one hand. Units with offhand weapons do not gain this benefit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Scavengers Arsenal" id="0acf-68d0-c96d-b8a1" hidden="false" import="true" sortIndex="5" type="upgrade">
              <constraints>
                <constraint id="aac6-b23f-8bf2-fcd1" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Scavengers Arsenal" id="378f-b2b3-ef98-02b2" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add the following weapons permanently to your warband&apos;s purchasable Battlekit:
- Submachine Gun | 2 Glory | Limit: 1
- Misericordia | 1 Glory | Limit: 2</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sheikh&apos;s Favor" id="c324-4dab-f62a-28ee" hidden="false" import="true" sortIndex="6" type="upgrade">
              <constraints>
                <constraint id="d62c-af7f-430d-f560" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
