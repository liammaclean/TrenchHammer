                <constraint id="3721-061f-8178-824a" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <profiles>
                <profile name="Armour &amp; Equipment Procurement" id="acfc-36d6-c2eb-ec26" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The cost of any Armour, Shields or Equipment worth 15 Ducats or more is reduced by 5 Ducats  if a model with this Skill is part of the Warband. A Warband can have only one model with this Skill.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
