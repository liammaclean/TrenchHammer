                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The cost of any Ranged Weapon or Grenade worth 20 Ducats or more is reduced by 5 Ducats if a model with this Skill is part of the Warband. A Warband can have only one model with this Skill.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
