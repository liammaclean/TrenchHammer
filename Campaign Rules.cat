                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Ranged Attacks made by a model with this Skill need 1 less BLOOD MARKER to convert an Injury Roll roll to a Bloodbath Roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Special Assault Training" id="3325-14ce-ea1f-2e76" hidden="false" import="true" sortIndex="6" type="upgrade">
              <constraints>
                <constraint id="ff1e-a89b-2dab-9529" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
