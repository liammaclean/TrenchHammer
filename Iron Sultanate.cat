        <profile name="Assault Beast" id="a838-cd2e-48a0-258a" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Shirdal  is armed with two Melee Weapons (its Damascus Talons and Crushing Beak). When it makes a Melee Attack, it can attack once using either its Damascus Talons or Crushing Beak, or twice, first with the Damascus Talons and second with its Crushing Beak (the Off-Hand Weapon modifier applies to the attack made with the Crushing Beak).</characteristic>
          </characteristics>
