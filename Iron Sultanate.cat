    <selectionEntry name="Bedu Sharpshooter" id="bc0a-c750-bc8b-0419" hidden="true" import="true" type="model">
      <comment>Nomads of Al-Badia</comment>
      <categoryLinks>
        <categoryLink name="Troop" id="6301-1b7a-36cf-3a66" primary="true" targetId="bd43-ddb1-262d-4489"/>
      </categoryLinks>
      <constraints>
        <constraint id="16c4-da8e-b6ce-9859" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="max" value="2"/>
      </constraints>
      <costs>
        <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="110"/>
        <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
      </costs>
      <entryLinks>
