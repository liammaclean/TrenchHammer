                  <conditions>
                    <condition childId="99ce-8e70-94c9-35c4" field="selections" scope="parent" shared="true" type="atLeast" value="2"/>
                  </conditions>
                </modifier>
              </modifiers>
            </entryLink>
          </entryLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="c251-4b5c-2ba0-82e0" field="selections" includeChildSelections="true" scope="model" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
            <modifier field="error" type="add" value="Max 1 Heavy item on Non-Strong Unit">
              <comment>Errors out if 2 or more Heavy on non-</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="70c9-988d-71a7-7654" field="selections" scope="parent" shared="true" type="greaterThan" value="1"/>
                    <condition childId="afcc-5f24-1c7c-63c4" field="selections" includeChildForces="false" scope="model" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
            <modifier field="40cf-637b-4374-d128" type="increment" value="2">
              <conditions>
                <condition childId="5dc9-f57b-d3e0-5003" field="selections" includeChildSelections="true" scope="model" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
