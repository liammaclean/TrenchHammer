                <characteristic name="Range" typeId="31a7-b5e8-41dc-5fd1">40&quot;</characteristic>
                <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">ASSAULT, CRITICAL, IGNORE ARMOUR</characteristic>
                <characteristic name="Rules" typeId="87f0-637b-734a-22eb">Temporal Slipstream: If a Ranged Attack made with this Weapon causes any BLOOD MARKERS to be placed on the target model, you can immediately redeploy the attacking model within 1&quot; of the target model, regardless of the distance or any intervening obstacles. Note that if the attack takes the target Out of Action, no BLOOD MARKERS are placed and this ability cannot be used.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
