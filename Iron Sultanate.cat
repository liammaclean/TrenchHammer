          <profiles>
            <profile name="Guiding Strike" id="3147-3cb8-b5b3-159d" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The first time during a Turn this model successfully deals a BLOOD MARKER to an enemy model, all Ranged Attack and Melee Attack Success Rolls made by friendly models in your warband made against the same model gain +1 DICE until the end of the current round.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
