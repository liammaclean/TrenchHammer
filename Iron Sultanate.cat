        </profile>
        <profile name="Weapons Platform" id="9f03-e973-56f5-8a66" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">This model always counts as being on a 3” high platform when it makes a Ranged Attack, thus granting it the benefits of Elevated position against any enemy model on the same level as itself.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntryGroups>
