            <characteristic name="Type" typeId="f90e-171a-4ca6-3845">2-handed</characteristic>
            <characteristic name="Range" typeId="31a7-b5e8-41dc-5fd1">Melee</characteristic>
            <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">CUMBERSOME, BLOCK</characteristic>
            <characteristic name="Rules" typeId="87f0-637b-734a-22eb">Attacks made against model with the keywords DEMONIC, HERETIC, and BLACK GRAIL add +1 INJURY DICE.</characteristic>
          </characteristics>
        </profile>
        <profile name="Nur Crest" id="6840-de3c-a380-dcc5" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Pairika can take a Nur Crest ACTION. If they do so, take a Risky Success Roll for the model. If the roll is a Failure, the Pairika’s Activation ends immediately. If the roll is a Success, you may choose a friendly unit within 3” of the Pairika and remove 1 BLOOD or INFECTION MARKER from the targeted model. If the roll is a Critical Success, remove up to 3 BLOOD OR INFECTION MARKER instead.</characteristic>
          </characteristics>
        </profile>
        <profile name="His Mercy" id="5a0b-170e-5ed3-360f" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Once per Turn when an other friendly unit would suffer an injury result, you may automatically set one of the Injury Dice results to a 1.</characteristic>
          </characteristics>
        </profile>
        <profile name="Celestial Vitality" id="af9b-3d2c-6807-c322" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add -2 INJURY DICE to Injury Rolls for a Pairika.</characteristic>
          </characteristics>
        </profile>
      </profiles>
