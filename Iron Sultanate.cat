          <profiles>
            <profile name="Janissary Veteran" id="8f21-dc64-88f6-1183" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">You can make the Yüzbaşı a Janissary Veteran with the STRONG Keyword and the Janissary Counter-Charge ability at a cost of +10 Ducats.</characteristic>
              </characteristics>
            </profile>
            <profile name="Counter-Charge" id="0561-6d7c-1c61-ecb5" hidden="false" noindex="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">If the first ACTION a Yüzbaşı makes during their Activation is a Charge, add +1 DICE to Melee Attacks made by the Yüzbaşı for the rest of the Activation.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Akinji-Bey" id="a0bc-2879-6cde-b11f" hidden="true" import="true" sortIndex="3" type="upgrade">
