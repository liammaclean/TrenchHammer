              <comment>Errors out if 2 or more Heavy on non-</comment>
              <conditions>
                <condition childId="0934-cc68-ca08-7e2b" field="selections" scope="parent" shared="true" type="greaterThan" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <selectionEntryGroups>
            <selectionEntryGroup name="Ranged Weapons" id="4b28-56a0-0687-8294" hidden="false" sortIndex="1">
              <constraints>
