              </constraints>
              <entryLinks>
                <entryLink name="Ranged (One-Handed)" id="7e20-fb93-9c0f-8047" collapsible="true" collective="false" hidden="false" import="true" targetId="12b2-a2c1-dcf8-980c" type="selectionEntryGroup"/>
                <entryLink name="Ranged (Two-Handed)" id="b99f-6b19-94a7-ed11" collapsible="true" hidden="false" import="true" targetId="3e28-4330-b057-c175" type="selectionEntryGroup">
                  <constraints>
                    <constraint id="6487-8245-4178-dbae" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
