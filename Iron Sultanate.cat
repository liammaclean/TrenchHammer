              <characteristics>
                <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">If the first ACTION the model makes during their Activation is a Charge, add +1 DICE to Melee Attacks made by this model for the rest of the Activation.</characteristic>
              </characteristics>
