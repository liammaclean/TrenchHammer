        <profile name="Artificial Life" id="c57a-8333-1d35-ae34" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add -1 INJURY DICE to Injury Rolls for a Lion of Jabir</characteristic>
          </characteristics>
        </profile>
        <profile name="Agile" id="c71e-93f6-98c1-4b2c" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add +1 DICE to Risky Success Roll when a Lion of Jabir Climbs, Jumps, or makes a Diving Charge, or takes a Dash ACTION.</characteristic>
          </characteristics>
        </profile>
        <profile name="Pin" id="31e8-c7ae-36d7-d76c" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Enemy models that are Down and that are mounted on a base of 40mm or less are not allowed to stand up if a Lion of Jabir is within 1&quot; of them (even if the Lion of Jabir is also Down).</characteristic>
          </characteristics>
        </profile>
        <profile name="Teeth and Claws" id="364b-3951-419e-544e" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Lion of Jabir can make a Melee Attack even though it does not have any Melee Weapons.</characteristic>
          </characteristics>
        </profile>
      </profiles>
