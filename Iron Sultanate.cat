        <profile name="Chimeric Vitality" id="e144-884a-e38f-f8e7" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add -1 INJURY DICE to Injury Rolls for a Shirdal unless the weapon has the keyword FIRE or GAS.</characteristic>
          </characteristics>
        </profile>
        <profile name="Winged Beast" id="5e9a-d92f-0c5f-cf07" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Add +1 DICE to Risky Success Roll when a Shirdal makes a Diving Charge or takes a Dash ACTION.</characteristic>
          </characteristics>
        </profile>
