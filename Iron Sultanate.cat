                  <characteristics>
                    <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Shield</characteristic>
                    <characteristic name="Range" typeId="2b32-2f45-9c06-7a77"/>
                    <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-1 INJURY MODIFIER, NEGATE FIRE</characteristic>
                    <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Fire Shield: Add -1 INJURY DICE to Injury Rolls for attacks with the FIRE Keyword that targets a model that has a Fire Shield, even if the attacking weapon has the IGNORE ARMOUR Keyword.</characteristic>
                  </characteristics>
                </profile>
