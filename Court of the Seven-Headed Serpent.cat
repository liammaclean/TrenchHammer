              <profiles>
                <profile name="Belly of the Beast" id="5976-ff11-d2d8-06e7" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">After making a Melee Attack that targets a model with this Goetic Ability, place 1 BLOOD MARKER next to the attacking model as long as at least 1 BLOOD MARKER was placed on the model with this Goetic Ability as a result of the attack.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Uncaring Gluttony" id="c598-d0e1-26bb-4d64" hidden="true" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="c927-b080-aae0-c93a" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="18a0-064a-674f-af00" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditions>
                    <condition childId="3de0-192c-3ec2-51be" field="selections" scope="model" shared="true" type="instanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Uncaring Gluttony" id="7b6f-566f-3690-6a06" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
                  <characteristics>
                    <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Spell (Cost 2)</characteristic>
                    <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                    <characteristic name="Keywords" typeId="5093-5528-b08f-1496"/>
                    <characteristic name="Rules" typeId="4834-43a9-1c93-9062">You must take a Cast Spell ACTION with the spellcaster in order for it to cast this spell. If you do so, pick 1 enemy model that has not yet been Activated this Turn, and pick one piece of Equipment that the model has (note its Type must be Equipment, not Weapon or Special and so on). Equipment that has the CONSUMABLE Keyword cannot be picked as it has already been consumed, and Equipment that has the DEPLOYABLE Keyword cannot be picked if it is more than 1” away from the model. The model chews on the Equipment, rendering it unusable for the rest of the game.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Eater of the Flesh" id="c333-2591-5b6e-e20b" hidden="true" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="a49a-fca8-af5f-5de3" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="8281-11c9-d2ce-7491" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
              </costs>
              <modifiers>
                <modifier field="hidden" type="set" value="false">
                  <conditionGroups>
