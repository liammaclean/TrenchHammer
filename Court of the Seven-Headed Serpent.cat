          <modifiers>
            <modifier field="5bbe-59db-133e-ef69" type="decrement" value="1">
              <comment>stolen from sultans to account for the homonculus</comment>
              <conditionGroups>
                <conditionGroup type="and">
                  <conditionGroups>
                    <conditionGroup type="or">
                      <conditions>
                        <condition childId="64ea-216e-161f-7584" field="selections" scope="parent" shared="true" type="notEqualTo" value="1"/>
                        <condition childId="976c-a249-8154-5549" field="selections" scope="parent" shared="true" type="notEqualTo" value="1"/>
                      </conditions>
                    </conditionGroup>
                    <conditionGroup type="or">
                      <comment>Strong is overwritten by Cumbersome</comment>
                      <conditionGroups>
                        <conditionGroup type="or">
                          <conditionGroups>
                            <conditionGroup type="and">
                              <comment>one 2 handed, none can be cumbersome</comment>
                              <conditions>
                                <condition childId="f87d-5ea3-e505-6a9f" field="selections" includeChildSelections="true" scope="self" shared="true" type="greaterThan" value="0"/>
                                <condition childId="4f68-d195-3b2a-2bf8" field="selections" scope="parent" shared="true" type="equalTo" value="1"/>
                              </conditions>
                            </conditionGroup>
                            <conditionGroup type="and">
                              <comment>two 2 handed, one can be cumbersome</comment>
                              <conditions>
                                <condition childId="f87d-5ea3-e505-6a9f" field="selections" includeChildSelections="true" scope="self" shared="true" type="greaterThan" value="1"/>
                                <condition childId="4f68-d195-3b2a-2bf8" field="selections" scope="parent" shared="true" type="equalTo" value="2"/>
                              </conditions>
                            </conditionGroup>
                          </conditionGroups>
                        </conditionGroup>
                      </conditionGroups>
                      <conditions>
                        <condition childId="afcc-5f24-1c7c-63c4" field="selections" includeChildForces="false" scope="model" shared="true" type="notInstanceOf" value="1"/>
