          <selectionEntryGroups>
            <selectionEntryGroup name="Melee Weapons" id="5c62-e993-3439-6353" hidden="false">
              <constraints>
                <constraint id="2ed9-8f77-5ca1-a3a3" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <entryLinks>
                <entryLink name="Melee (One-Handed)" id="d043-1b47-6ce0-a476" collapsible="true" collective="false" hidden="false" import="true" targetId="02d4-0537-9a27-5baa" type="selectionEntryGroup">
                  <constraints>
                    <constraint id="32cd-8c86-1413-0fc5" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                </entryLink>
              </entryLinks>
              <modifierGroups>
                <modifierGroup type="and">
                  <modifiers>
                    <modifier field="2ed9-8f77-5ca1-a3a3" type="increment" value="1">
                      <comment>shield combo refun</comment>
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="64ea-216e-161f-7584" field="selections" scope="parent" shared="true" type="atLeast" value="1"/>
                            <condition childId="976c-a249-8154-5549" field="selections" scope="parent" shared="true" type="atLeast" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                    <modifier field="2ed9-8f77-5ca1-a3a3" type="decrement" value="1">
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditions>
                            <condition childId="6ffb-5ac2-a05a-8c44" field="selections" includeChildSelections="true" scope="model" shared="true" type="atLeast" value="1"/>
                            <condition childId="0447-09f8-8cc2-64da" field="selections" includeChildSelections="false" scope="model" shared="true" type="notInstanceOf" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                    <modifier field="2ed9-8f77-5ca1-a3a3" type="increment" value="1">
                      <comment>strength refund</comment>
                      <conditionGroups>
                        <conditionGroup type="and">
                          <conditionGroups>
                            <conditionGroup type="or">
                              <conditionGroups>
                                <conditionGroup type="and">
                                  <comment>one 2 handed, none can be cumbersome</comment>
                                  <conditions>
                                    <condition childId="f87d-5ea3-e505-6a9f" field="selections" includeChildSelections="true" scope="self" shared="true" type="lessThan" value="1"/>
                                    <condition childId="4f68-d195-3b2a-2bf8" field="selections" scope="parent" shared="true" type="equalTo" value="1"/>
                                  </conditions>
                                </conditionGroup>
                                <conditionGroup type="and">
                                  <comment>two 2 handed, one can be cumbersome</comment>
                                  <conditions>
                                    <condition childId="f87d-5ea3-e505-6a9f" field="selections" includeChildSelections="true" scope="self" shared="true" type="lessThan" value="2"/>
                                    <condition childId="4f68-d195-3b2a-2bf8" field="selections" scope="parent" shared="true" type="equalTo" value="2"/>
                                  </conditions>
                                </conditionGroup>
                              </conditionGroups>
                            </conditionGroup>
                          </conditionGroups>
                          <conditions>
                            <condition childId="4f68-d195-3b2a-2bf8" field="selections" scope="parent" shared="true" type="atLeast" value="1"/>
                            <condition childId="afcc-5f24-1c7c-63c4" field="selections" includeChildForces="false" scope="model" shared="true" type="instanceOf" value="1"/>
                          </conditions>
                        </conditionGroup>
                      </conditionGroups>
                    </modifier>
                    <modifier field="2ed9-8f77-5ca1-a3a3" type="decrement" value="1">
                      <repeats>
                        <repeat childId="4f68-d195-3b2a-2bf8" field="selections" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                        <repeat childId="2c66-b5c4-72e2-82ed" field="selections" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                      </repeats>
                    </modifier>
                    <modifier field="2ed9-8f77-5ca1-a3a3" type="increment" value="1">
                      <conditions>
                        <condition childId="0b34-115a-118f-e8df" field="selections" includeChildSelections="true" scope="model" shared="true" type="atLeast" value="1"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </modifierGroup>
              </modifierGroups>
            </selectionEntryGroup>
            <selectionEntryGroup name="Ranged Weapons" id="1b1f-6d31-f3e8-2fd5" hidden="false">
              <entryLinks>
