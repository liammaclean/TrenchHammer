              </conditions>
            </modifier>
            <modifier field="12e8-ff8c-c933-9eb5" type="set" value="+1 Dice">
              <conditions>
                <condition childId="52dd-8148-fabf-d590" field="selections" includeChildSelections="true" scope="self" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
            <modifier field="1a4f-d2cd-c405-6200" type="set" value="+1 Dice">
              <conditions>
