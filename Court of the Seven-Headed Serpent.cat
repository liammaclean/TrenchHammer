              <profiles>
                <profile name="Forbidden Pleasures" id="bab7-f552-bd8e-ba33" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">You can use this Goetic Ability at the start of each game, before deployment. For each model in your Warband that has this Goetic Ability, you can pick a model from your Warband that does not have the DEMONIC Keyword. Place 3 BLOOD MARKERS next to each model that you pick.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Exquisite Pain" id="8a96-4a3d-9183-b2bb" hidden="true" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="466f-09fe-5572-732f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
