              <profiles>
                <profile name="Fire Shield" id="6dec-b744-5999-b2b0" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
                  <characteristics>
                    <characteristic name="Type" typeId="3f15-74a1-4d35-3642"/>
