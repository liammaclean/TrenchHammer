      </modifiers>
      <profiles>
        <profile name="Terminator Armour" id="ce0f-8946-51f2-1ff3" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
          <characteristics>
            <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Armour</characteristic>
            <characteristic name="Range" typeId="2b32-2f45-9c06-7a77"/>
            <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-3 INJURY MODIFIER</characteristic>
            <characteristic name="Rules" typeId="4834-43a9-1c93-9062">Model gains the DEEP STRIKE, STRONG, and VEHICLE Keywords, as well as LARGE if not already LARGE. It can wield a TWO-HANDED ranged weapon in one hand instead of a TWO-HANDED melee weapon due to its STRONG Keyword. Due to its bulk the wearer has -1” movement speed. Terminator Armour cannot be combined with a Shield, nor used with a Jump Pack.</characteristic>
          </characteristics>
        </profile>
      </profiles>
