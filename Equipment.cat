      <infoLinks>
        <infoLink name="+/- Injury Modifier" id="c686-2a28-682d-69df" hidden="false" targetId="3f79-aee7-2c3d-828f" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier affects="unit.profiles.Unit" field="5de9-d70e-9021-6f71" position="0" type="increment" value="-2"/>
      </modifiers>
      <profiles>
        <profile name="Heavy Armour" id="504c-42b8-c5d1-d29c" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
          <characteristics>
            <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Armour</characteristic>
            <characteristic name="Range" typeId="2b32-2f45-9c06-7a77"/>
            <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-2 INJURY MODIFIER, HEAVY</characteristic>
            <characteristic name="Rules" typeId="4834-43a9-1c93-9062">The equipped model suffers the penalty of the HEAVY Keyword with all of its ranged attacks in addition to charge distance. A model that can ignore HEAVY for one melee weapon can instead reduce the charge distance penalty to D3, while a model that can ignore HEAVY for one ranged weapon can instead ignore the limit on firing ranged weapons, and a model that can ignore HEAVY for any one weapon can instead choose one to ignore when equipped. Due to its bulk, even a STRONG wearer rolls only a D3 for extra charge distance instead of a D6.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
