          </costs>
          <infoLinks>
            <infoLink name="Fireteam" id="0183-6941-c02b-05f1" hidden="false" targetId="a3e2-4af7-ab99-e6b1" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Man&apos;s Best Friend" id="ce55-e4a0-f88f-0df9" hidden="false" typeId="7079-589c-df69-fa7e" typeName="Battlekit">
              <characteristics>
                <characteristic name="Type" typeId="3f15-74a1-4d35-3642">Ability</characteristic>
                <characteristic name="Range" typeId="2b32-2f45-9c06-7a77">-</characteristic>
                <characteristic name="Keywords" typeId="5093-5528-b08f-1496">-</characteristic>
                <characteristic name="Rules" typeId="4834-43a9-1c93-9062">This model may form a fireteam with another model in your Warband.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
      <selectionEntryGroups>
        <selectionEntryGroup name="Specialization" id="eef4-f47a-3aa7-e393" hidden="false">
