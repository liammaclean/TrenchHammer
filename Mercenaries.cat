                    <characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">8&quot;/Infantry</characteristic>
                    <characteristic name="Ranged" typeId="1a4f-d2cd-c405-6200">N/A</characteristic>
                    <characteristic name="Melee" typeId="12e8-ff8c-c933-9eb5">0</characteristic>
                    <characteristic name="Armour" typeId="5de9-d70e-9021-6f71">0</characteristic>
                    <characteristic name="Base" typeId="73ae-cc17-596e-0481">25mm</characteristic>
                  </characteristics>
                </profile>
                <profile name="Guardian Angel" id="e280-c990-4a68-4155" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Mercy Dogs have and can use a Medi-kit. In addition, when you move a Mercy Dog that starts the move in contact with a friendly model that is Down that is more than 1&quot; from any enemy models, it can drag the friendly model along with itself. If it does so, halve the Mercy Dog’s Movement Characteristic. A Mercy Dog cannot drag a friendly model when it retreats or charges.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Hellhound" id="b990-d914-9dce-66af" hidden="true" import="true" sortIndex="5" type="upgrade">
