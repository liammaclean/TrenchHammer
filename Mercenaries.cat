      <profiles>
        <profile name="Mamluk Faris" id="a674-6866-aab4-a938" hidden="false" typeId="b3af-94f9-2e35-d1c5" typeName="Unit">
          <characteristics>
            <characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">6&quot;/Infantry</characteristic>
            <characteristic name="Ranged" typeId="1a4f-d2cd-c405-6200">+1 Dice</characteristic>
            <characteristic name="Melee" typeId="12e8-ff8c-c933-9eb5">+1 Dice</characteristic>
            <characteristic name="Armour" typeId="5de9-d70e-9021-6f71">-2</characteristic>
            <characteristic name="Base" typeId="73ae-cc17-596e-0481">32mm</characteristic>
          </characteristics>
          <modifiers>
            <modifier field="5de9-d70e-9021-6f71" type="decrement" value="1">
              <conditions>
                <condition childId="68d9-a653-9765-d3e7" field="selections" includeChildSelections="true" scope="self" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
            <modifier field="1a4f-d2cd-c405-6200" type="increment" value="1">
              <conditions>
