      <profiles>
        <profile name="Combat Medic" id="aa7f-02df-a12f-1ed3" hidden="false" typeId="b3af-94f9-2e35-d1c5" typeName="Unit">
          <characteristics>
            <characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">6&quot;/Infantry</characteristic>
