          </constraints>
          <selectionEntries>
            <selectionEntry name="Guard Dog" id="4d84-784e-a2c6-53c0" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="3932-e824-7713-45b8" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="0"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="1"/>
              </costs>
              <modifiers>
