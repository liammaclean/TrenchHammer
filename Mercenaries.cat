        <profile name="Pack Loyalty" id="c45a-e0c1-402d-9d28" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">A Trench Dog has the same Faction Keyword as the model that has it. For example, the owner of a Trench Dog had the NEW ANTIOCH Faction Keyword, then the Trench Dog will have the NEW ANTIOCH Faction Keyword too.</characteristic>
          </characteristics>
