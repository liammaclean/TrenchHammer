            <profile name="Tenderizer Maul" id="c63d-fe53-a980-4a2a" hidden="false" typeId="090c-b12e-592a-9874" typeName="Weapon">
              <characteristics>
                <characteristic name="Type" typeId="f90e-171a-4ca6-3845">2-Handed</characteristic>
                <characteristic name="Range" typeId="31a7-b5e8-41dc-5fd1">Melee</characteristic>
                <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">+1 INJURY MODIFIER, HEAVY</characteristic>
                <characteristic name="Rules" typeId="87f0-637b-734a-22eb">Swinging Blow: When a model armed with a Tenderiser Maul takes a Fight ACTION, instead of making only 1 Melee Attack, you can make 1 Melee Attack against each enemy model with 1&quot; of the attacking model. Resolve each Melee Attack one at a time in the order of your choice.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
