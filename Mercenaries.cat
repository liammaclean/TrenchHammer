            <condition childId="a1a3-ab0f-8d5c-e5ff" field="selections" scope="self" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="false">
          <conditionGroups>
            <conditionGroup type="and">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="72ab-daa4-80ee-e9a5" field="selections" scope="primary-catalogue" shared="true" type="instanceOf" value="1"/>
