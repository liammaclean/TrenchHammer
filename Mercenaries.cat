                    </conditionGroup>
                  </conditionGroups>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Mercy Dog" id="1331-ddb8-fad3-81a3" hidden="false" typeId="b3af-94f9-2e35-d1c5" typeName="Unit">
