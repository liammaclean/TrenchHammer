                <characteristic name="Keywords" typeId="8cd6-8018-f2da-5ede">CLEAVE 2, CRITICAL</characteristic>
                <characteristic name="Rules" typeId="87f0-637b-734a-22eb">A Goetic Warlock can make a Melee Attack with the CLEAVE 2 and CRITICAL Keywords even though it does not have a Melee Weapon. In addition, the Off-Hand Weapon modifier applies to the second attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
