              </modifiers>
              <profiles>
                <profile name="Night Runner" id="913a-bd16-503d-9728" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Up to 2 Clanrats, or 3 in a Warband worth 1,200 or more credits, can be upgraded to Night Runners at a cost of +15 credits each, granting them the INFILTRATOR and STEALTH Keywords, and the Slinking Advance Ability.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Slinking Advance" id="e128-1372-7d21-7b04" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Night Runner can Charge an enemy it cannot see, and when it does so, it ignores its Cowardice Ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pack Master" id="9edb-cc08-ad18-0981" hidden="false" import="true" type="upgrade">
