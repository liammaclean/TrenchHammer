      <profiles>
        <profile name="Deathmaster" id="dd4d-980c-49a9-3232" hidden="false" typeId="b3af-94f9-2e35-d1c5" typeName="Unit">
          <characteristics>
            <characteristic name="Movement" typeId="b725-e0a4-16ae-8df2">6&quot;</characteristic>
            <characteristic name="Ranged" typeId="1a4f-d2cd-c405-6200">+1</characteristic>
            <characteristic name="Melee" typeId="12e8-ff8c-c933-9eb5">+2</characteristic>
            <characteristic name="Armour" typeId="5de9-d70e-9021-6f71">0</characteristic>
            <characteristic name="Base" typeId="73ae-cc17-596e-0481">25-32mm</characteristic>
          </characteristics>
        </profile>
        <profile name="Scurry Away" id="e014-3194-7869-67e1" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Enemies do not get to make a free attack when the Clawlord Retreats.</characteristic>
          </characteristics>
        </profile>
        <profile name="Tunneljack" id="00d7-4928-4329-941e" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">As an Action with a Risky Success Roll with +1 DICE, the Deathmaster can attempt to teleport. On a success, you can pick up the Deathmaster and deploy it on the battlefield anywhere within 6&quot; of the location it originally occupied (measured from the centre of its base to the centre of its base). If this is impossible for any reason, the Deathmaster must stay in its original position. Note that the Deathmaster can redeploy even if it is down or within 1&quot; of an enemy model (in which case the enemy model cannot make a Melee Attack before the Deathmaster is redeployed), and can deploy within 1&quot; of an enemy model. In addition, if the Deathmaster is within 1&quot; of any enemy models that are not LARGE, then the Deathmaster can take 1 of the enemy models with them. If they do so, you must deploy the Deathmaster first and then deploy the enemy model within 1&quot; of the Deathmaster. If you cannot deploy the enemy model within 1&quot; of the Deathmaster, then the enemy model stays in its original position.</characteristic>
          </characteristics>
        </profile>
        <profile name="Running Death" id="58fa-f27d-2324-2a79" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Deathmaster has +1 DICE to all Dash Success Rolls.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
