          <selectionEntries>
            <selectionEntry name="Night Runner" id="b1dd-6f5d-e903-4835" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="71c0-60ca-238f-8414" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="2"/>
