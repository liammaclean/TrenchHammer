            <selectionEntry name="Arch-Warlock" id="abb3-0b8a-d3a8-edac" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
              </costs>
              <profiles>
                <profile name="Arch-Warlock" id="6faa-365c-7d07-5056" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Arch-Warlock can purchase up to five powers, and it has the PSYKER 2 Keyword instead of PSYKER 1.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Warlock Bombardier" id="436c-c90e-5391-5aff" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
              </costs>
              <profiles>
                <profile name="Warlock Engineer" id="e643-5baf-193e-5961" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Warlock Bombardier can ignore the HEAVY Keyword of up to one ranged weapon it wields, and it can ignore the HELD Keyword of up to one PSYCHIC weapon it wields.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Warlock Engineer" id="54bc-25c1-7c7a-a6d8" hidden="false" import="true" type="upgrade">
              <costs>
                <cost name="Ducats" typeId="8d43-33fd-332d-17a6" value="10"/>
                <cost name="Glory Points" typeId="f3bb-a7e6-d476-f60b" value="0"/>
              </costs>
              <profiles>
                <profile name="Warlock Engineer" id="32eb-7d63-6168-00c0" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Warp-Power Accumulator. Injuries caused by the Warlock Engineer’s psychic powers, including attacks, have +1 INJURY DICE.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Warband Variant" id="da24-af65-e5dd-70f7" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="Configuration" id="007a-0d95-9a9b-9484" hidden="false" primary="true" targetId="705b-e23f-e9c2-58ab"/>
      </categoryLinks>
      <constraints>
        <constraint id="b1d9-b027-530d-8264" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntryGroups>
        <selectionEntryGroup name="Variant Selection" id="b962-7a96-0ab0-e243" hidden="false">
          <selectionEntries>
            <selectionEntry name="Plague Vermin" id="a1c3-7bfe-5eb0-34b0" hidden="false" import="true" type="upgrade">
              <profiles>
                <profile name="Rats of Nurgle" id="23ec-6619-c9dd-51e6" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">All of your non-mercenary models gain the NURGLE Keyword. Your Patron must be the Nurgle Shared Patron.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Priesthood of Rot" id="519b-867a-08d0-e9fa" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">You cannot recruit a Clawlord or Warlock. Instead, you can recruit up to 2 Plague Priest mercenaries, which count as Elites in your Warband instead of mercenaries. They lose MERCENARY and gain ELITE. You must recruit at least 1 as your Warband leader, which gains the LEADER and TOUGH Keywords.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
