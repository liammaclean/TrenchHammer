        </profile>
        <profile name="Cowerdice" id="c7f6-4f77-5641-204a" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Charge Action is always a Risky Success Roll for the Skavenslave unless a friendly MASTER SKAVEN model is within 6” of the Skavenslave.</characteristic>
          </characteristics>
        </profile>
        <profile name="Many" id="8f9f-a800-e5d9-7500" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">When you activate a Skavenslave, activate another unactivated Skavenslave, treating them as a Fireteam, if one is available (this does not cause this ability to trigger again). The Skavenslave counts for only half of a model for the purpose of Field Strength and Morale. Round up after counting all Skavenslaves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
