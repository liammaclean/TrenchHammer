        <profile name="Cowerdice" id="b826-9372-562d-d98e" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Charge Action is always a Risky Success Roll for the Skavenslave unless a friendly MASTER SKAVEN model is within 6” of the Skavenslave.</characteristic>
          </characteristics>
        </profile>
        <profile name="Strength in Numbers" id="7704-0a7d-79c9-98a0" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Clanrat has +1 DICE to Hit with melee attacks made against any enemy that has at least 2 of the Clanrat’s SKAVEN allies within 1” of it. In addition, it ignores its Cowardice Ability if the target of its Charge is already in melee with at least 1 of the Clanrat’s SKAVEN allies.</characteristic>
          </characteristics>
        </profile>
      </profiles>
