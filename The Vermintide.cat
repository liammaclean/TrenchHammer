                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">Up to 2 Clanrats, or 3 in a Warband worth 1,200 or more credits, can be upgraded to Plague Monks at a cost of +10 credits each, granting them the Frenzied Assault Ability.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Frenzied Assault" id="cdf9-b037-fd5c-78ec" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
                  <characteristics>
                    <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">The Plague Monk ignores its Cowardice Ability, and it has +2” movement speed when it Charges.</characteristic>
                  </characteristics>
