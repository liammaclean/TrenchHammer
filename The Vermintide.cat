        <profile name="Lead From the Back" id="f5c4-20c1-d5e2-ff93" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
          <characteristics>
            <characteristic name="Description" typeId="2ecd-b4ff-9e78-a8e2">While it is within 3” of a friendly SKAVEN model, if that model is a valid target for such an attack, the Clawlord cannot be chosen as the target of any ranged attack.</characteristic>
          </characteristics>
        </profile>
        <profile name="Scurry Away" id="fd26-1add-b777-98af" hidden="false" typeId="058c-866b-6487-ccc4" typeName="Ability">
